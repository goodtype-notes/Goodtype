[
  {
    "name": "end rotates and clamps around a nonzero local origin",
    "group": {"x": 10, "y": 20, "rotation": 0, "scale": 2},
    "start": {"x": 2, "y": 3},
    "end": {"x": 42, "y": 3},
    "startMoved": false,
    "endpoint": {"x": 14, "y": 66},
    "minimum": 24,
    "expected": [{"x": 14, "y": 26}, {"x": 14, "y": 74}]
  },
  {
    "name": "start crosses the fixed end with its port identity",
    "group": {"x": 10, "y": 20, "rotation": 0, "scale": 2},
    "start": {"x": 0, "y": 0},
    "end": {"x": 40, "y": 0},
    "startMoved": true,
    "endpoint": {"x": 150, "y": 20},
    "minimum": 24,
    "expected": [{"x": 150, "y": 20}, {"x": 90, "y": 20}]
  },
  {
    "name": "coincident end retains ordered heading",
    "group": {"x": 30, "y": 10, "rotation": 90, "scale": 0.5},
    "start": {"x": 5, "y": 2},
    "end": {"x": 45, "y": 2},
    "startMoved": false,
    "endpoint": {"x": 29, "y": 12.5},
    "minimum": 20,
    "expected": [{"x": 29, "y": 12.5}, {"x": 29, "y": 22.5}]
  },
  {
    "name": "coincident start retains ordered heading",
    "group": {"x": 30, "y": 10, "rotation": 90, "scale": 0.5},
    "start": {"x": 5, "y": 2},
    "end": {"x": 45, "y": 2},
    "startMoved": true,
    "endpoint": {"x": 29, "y": 32.5},
    "minimum": 20,
    "expected": [{"x": 29, "y": 22.5}, {"x": 29, "y": 32.5}]
  }
]
