{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goodtype addon index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "sequence",
    "issued",
    "expires",
    "addons"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "issued": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z(?![\\s\\S])"
    },
    "expires": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z(?![\\s\\S])"
    },
    "addons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "publicKey",
          "versions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 48,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
          },
          "repository": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+(?![\\s\\S])"
          },
          "publicKey": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "api",
                "target",
                "url",
                "size",
                "sha256"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "maxLength": 32,
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])"
                },
                "api": {
                  "type": "string",
                  "pattern": "^goodtype-api 0\\.[0-9]+(?![\\s\\S])"
                },
                "target": {
                  "const": "x86_64-pc-windows-msvc"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+/releases/download/[^/?#\\s]+/[^/?#\\s]+(?![\\s\\S])"
                },
                "size": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 536870912
                },
                "sha256": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64,
                  "pattern": "^[0-9a-fA-F]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
