{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goodtype addon index v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "sequence",
    "issued",
    "expires",
    "addons"
  ],
  "properties": {
    "format": {
      "const": 2
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "issued": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z(?![\\s\\S])"
    },
    "expires": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z(?![\\s\\S])"
    },
    "addons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "publicKey",
          "versions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 48,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
          },
          "repository": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+(?![\\s\\S])"
          },
          "publicKey": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "version",
                "api",
                "target",
                "url",
                "size",
                "sha256"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "maxLength": 32,
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])"
                },
                "api": {
                  "type": "string",
                  "pattern": "^goodtype-api 0\\.[0-9]+(?![\\s\\S])"
                },
                "target": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+/releases/download/[^/?#\\s]+/[^/?#\\s]+(?![\\s\\S])"
                },
                "size": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 536870912
                },
                "sha256": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64,
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "minGoodtype": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
                },
                "requires": {
                  "type": "array",
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "maxLength": 48,
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  }
                }
              },
              "description": "Unknown release fields or unsupported requirements make only this release incompatible. Index and addon entries remain strict."
            }
          },
          "docs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commit",
              "summary",
              "readme"
            ],
            "properties": {
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
              },
              "summary": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "en",
                  "de"
                ],
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
                  },
                  "de": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
                  }
                }
              },
              "readme": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "size",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?!.*\\.\\.)(?!\\.(/|$))[A-Za-z0-9_.-]+(?:/(?!\\.(/|$))[A-Za-z0-9_.-]+)*(?![\\s\\S])"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 262144
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{64}(?![\\s\\S])"
                  }
                }
              },
              "preview": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "size",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?!.*\\.\\.)(?!\\.(/|$))[A-Za-z0-9_.-]+(?:/(?!\\.(/|$))[A-Za-z0-9_.-]+)*(?![\\s\\S])"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2097152
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{64}(?![\\s\\S])"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
